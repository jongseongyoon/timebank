generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// 회원 관련
// ─────────────────────────────────────────

model Member {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 인증
  email        String?  @unique
  phone        String   @unique
  passwordHash String?
  kakaoId      String?  @unique

  // 기본 정보
  name      String
  birthDate String?  // YYYYMMDD 8자리 (신규 회원부터)
  dong      String
  address   String?

  // 역할 및 상태
  memberType   MemberType   @default(INDIVIDUAL)
  roles        Role[]
  status       MemberStatus @default(ACTIVE)
  isVulnerable Boolean      @default(false)
  isDisabled   Boolean      @default(false)

  // TP 잔액
  tpBalance      Decimal @default(0) @db.Decimal(10, 2)
  lifetimeEarned Decimal @default(0) @db.Decimal(10, 2)
  lifetimeSpent  Decimal @default(0) @db.Decimal(10, 2)

  tpExpiresAt DateTime?

  // 구글 시트 동기화
  sheetRowId   String?   // 구글 시트 행 식별자 (동_rowIndex)
  lastSyncedAt DateTime? // 마지막 동기화 시간
  syncSource   String    @default("MANUAL")  // 'MANUAL': 직접 가입 | 'SHEET': 구글 시트 가져오기

  // QR 코드 및 별점
  qrCode      String?
  avgRating   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)

  // 돌봄 필요도 (1=자립 ~ 5=완전의존)
  careLevel          Int?      @default(1)
  careLevelUpdatedAt DateTime?
  careLevelNote      String?

  careLevelRecords   CareLevelRecord[] @relation("CareLevelMember")
  assessedLevels     CareLevelRecord[] @relation("CareLevelAssessor")

  // 관계
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  providedServices  Transaction[]    @relation("Provider")
  receivedServices  Transaction[]    @relation("Receiver")
  coordinatedTxs   Transaction[]    @relation("Coordinator")
  serviceListings  ServiceListing[]
  notifications    Notification[]
  serviceRequests  ServiceRequest[]
  pushSubscriptions PushSubscription[]

  carePackagesAsRecipient    CarePackage[] @relation("CareRecipient")
  carePackagesAsCoordinator  CarePackage[] @relation("CareCoordinator")
  careSessionsAsProvider     CareSession[] @relation("CareSessionProvider")

  posts     Post[]
  comments  Comment[]
  postLikes PostLike[]
  walkRecords WalkRecord[]

  // 재원구조 관계
  healthFundTxs          HealthFundTransaction[]
  spFundTxs              SocialPrescriptionFundTx[]
  reserveFundTxs         ReserveFundTransaction[]
  receivedPrescriptions  SocialPrescription[]  @relation("PrescriptionReceiver")
  prescribedItems        SocialPrescription[]  @relation("Prescriber")
  coordinatedPrescriptions SocialPrescription[] @relation("PrescriptionCoordinator")
  adminIssuancesReceived AdminTpIssuance[]     @relation("IssuanceReceiver")
  sheetSyncs             GoogleSheetSync[]     @relation("SyncedBy")

  @@index([dong])
  @@index([status])
}

enum MemberType {
  INDIVIDUAL
  ORGANIZATION
  PUBLIC
}

enum Role {
  RECEIVER
  PROVIDER
  COORDINATOR
  ADMIN
}

enum MemberStatus {
  ACTIVE
  DORMANT
  SUSPENDED
  WITHDRAWN
}

// ─────────────────────────────────────────
// 자생단체/기관
// ─────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name        String
  orgType     OrgType
  dong        String
  tpBalance   Decimal   @default(0) @db.Decimal(10, 2)
  tpExpiresAt DateTime?

  members         Member[]
  transactions    OrgTransaction[]
  serviceListings ServiceListing[]
  tpTransactions  Transaction[]
  carePackages    CarePackage[]    @relation("CarePackageOrg")
}

enum OrgType {
  COMMUNITY_COUNCIL
  WELFARE_COUNCIL
  SAEMAEUL
  WOMENS_CLUB
  RIGHT_LIVING
  VOLUNTEER_CAMP
  RED_CROSS
  SOCIAL_COOP
  OTHER
}

// ─────────────────────────────────────────
// 서비스 목록
// ─────────────────────────────────────────

model ServiceListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider   Member? @relation(fields: [providerId], references: [id])
  providerId String?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  title             String
  description       String?
  category          ServiceCategory
  tpPerHour         Decimal         @db.Decimal(4, 2)
  availableDong     String[]
  availableDays     String[]
  availableTimeFrom String
  availableTimeTo   String

  latitude  Float?
  longitude Float?

  isActive     Boolean       @default(true)
  transactions Transaction[]
}

enum ServiceCategory {
  TRANSPORT
  SHOPPING
  COMPANION
  MEAL
  HOUSEKEEPING
  MEDICAL_ESCORT
  EDUCATION
  DIGITAL_HELP
  REPAIR
  CHILDCARE
  LEGAL_CONSULT
  HEALTH_CONSULT
  ADMINISTRATIVE
  COMMUNITY_EVENT
  OTHER
}

// ─────────────────────────────────────────
// TP 거래 원장
// ─────────────────────────────────────────

model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  txType     TxType
  provider   Member? @relation("Provider", fields: [providerId], references: [id])
  providerId String?
  receiver   Member? @relation("Receiver", fields: [receiverId], references: [id])
  receiverId String?

  serviceListing   ServiceListing? @relation(fields: [serviceListingId], references: [id])
  serviceListingId String?

  durationMinutes Int
  tpAmount        Decimal @db.Decimal(10, 2)
  baseRate        Decimal @db.Decimal(4, 2)
  bonusRate       Decimal @default(0) @db.Decimal(4, 2)

  coordinator        Member            @relation("Coordinator", fields: [coordinatorId], references: [id])
  coordinatorId      String
  verificationMethod VerificationMethod
  providerSignature  String?
  receiverConfirmed  Boolean           @default(false)

  prevTxHash String?
  txHash     String  @unique

  status      TxStatus  @default(PENDING)
  note        String?
  startedAt   DateTime?
  endedAt     DateTime?
  completedAt DateTime?

  // 별점 평가
  providerRating Int?
  receiverRating Int?
  providerReview String?
  receiverReview String?

  // 건강 위기 별점 (서비스 제공자가 수혜자 건강 상태 기록)
  healthRating    Int?    // 1-5 (3점 이상이면 상황+대책 필수)
  healthSituation String? // 현재 상황 기록
  healthAction    String? // 필요 대책 기록

  // 장기저축 표시 (제공자가 미래에 쓸 TP — 만기 면제 대상)
  isSavings   Boolean  @default(false)

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  fundTransaction FundTransaction? @relation(fields: [fundTxId], references: [id])
  fundTxId        String?

  careSession CareSession?

  @@index([providerId, createdAt])
  @@index([receiverId, createdAt])
  @@index([coordinatorId])
  @@index([status])
  @@index([createdAt])
}

enum TxType {
  PEER_TO_PEER
  INDIVIDUAL_TO_ORG
  ORG_TO_INDIVIDUAL
  PUBLIC_SERVICE
  PRIVATE_MARKET
  FREE_ALLOCATION
  WAGE_SUPPLEMENT
  COMMUNITY_BONUS
  EXPIRY_DONATION
  COMMUNITY_FUND_GIFT
}

enum TxStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum VerificationMethod {
  APP_QR
  APP_CONFIRM
  PHONE
  PAPER
  COORDINATOR
}

model OrgTransaction {
  id           String       @id @default(uuid())
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id])
  orgId        String
  txDirection  String
  tpAmount     Decimal      @db.Decimal(10, 2)
  description  String
  relatedTxId  String?
}

// ─────────────────────────────────────────
// 지불준비금 기금
// ─────────────────────────────────────────

model FundTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  fundTxType      FundTxType
  tpEquivalent    Decimal    @db.Decimal(10, 2)
  cashAmount      Decimal    @db.Decimal(12, 2)
  description     String
  approvedBy      String[]

  externalVendor  String?
  externalReceipt String?

  transactions Transaction[]
}

enum FundTxType {
  CONTRIBUTION        // 기금 적립 (광주서구청 출연)
  PRIVATE_PAYMENT     // 민간 결제
  EMERGENCY_SERVICE   // 긴급 서비스
  VULNERABLE_ALLOC    // 취약계층 배분
  EXTERNAL_PURCHASE   // 외부시장 구매 (회원 서비스 불가 시)
  REFUND
}

// ─────────────────────────────────────────
// 돌봄 패키지 (단체→수혜자 TP 배분 + 다수 제공자 이행)
// ─────────────────────────────────────────

model CarePackage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  category    ServiceCategory
  description String?

  // 수혜자
  recipientId String
  recipient   Member @relation("CareRecipient", fields: [recipientId], references: [id])

  // 배분 단체 (상무2동 행정복지센터 등)
  organizationId String?
  organization   Organization? @relation("CarePackageOrg", fields: [organizationId], references: [id])

  // TP 총량 (단체가 수혜자에게 배분)
  totalTpAmount  Decimal @db.Decimal(10, 2)  // 예: 90 TP
  usedTpAmount   Decimal @default(0) @db.Decimal(10, 2)

  // 서비스 일정
  startDate  DateTime
  endDate    DateTime
  dailyHours Decimal  @db.Decimal(4, 2)  // 3.0 시간
  totalDays  Int                          // 30 일

  status PackageStatus @default(ACTIVE)
  note   String?

  coordinatorId String
  coordinator   Member @relation("CareCoordinator", fields: [coordinatorId], references: [id])

  sessions CareSession[]

  @@index([recipientId])
  @@index([organizationId])
  @@index([status])
}

model CareSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  packageId String
  package   CarePackage @relation(fields: [packageId], references: [id])

  // 세션 제공자 (C학생, D학생 등)
  providerId String
  provider   Member @relation("CareSessionProvider", fields: [providerId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int
  tpAmount        Decimal @db.Decimal(10, 2)

  status      SessionStatus @default(SCHEDULED)
  completedAt DateTime?
  note        String?

  // 완료 시 생성된 거래
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([packageId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
}

enum PackageStatus {
  DRAFT
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────
// 서비스 요청
// ─────────────────────────────────────────

model ServiceRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester   Member @relation(fields: [requesterId], references: [id])
  requesterId String

  category        ServiceCategory
  description     String
  requestedDate   DateTime
  durationMinutes Int
  dong            String
  urgency         Urgency       @default(NORMAL)

  status             RequestStatus @default(OPEN)
  assignedProviderId String?
  coordinatorId      String?
  matchedAt          DateTime?
  completedTxId      String?
}

enum Urgency {
  EMERGENCY
  URGENT
  NORMAL
}

enum RequestStatus {
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ESCALATED
}

// ─────────────────────────────────────────
// 알림
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
}

// ─────────────────────────────────────────
// 커뮤니티
// ─────────────────────────────────────────

model Post {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  authorId  String
  author    Member      @relation(fields: [authorId], references: [id])

  title     String
  content   String
  category  PostCategory @default(GENERAL)
  viewCount Int         @default(0)
  likeCount Int         @default(0)
  isPinned  Boolean     @default(false)

  comments  Comment[]
  likes     PostLike[]

  @@index([category])
  @@index([createdAt])
  @@index([isPinned])
}

enum PostCategory {
  NOTICE
  GENERAL
  REVIEW
  QUESTION
}

model Comment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    Member   @relation(fields: [authorId], references: [id])

  content   String
  likeCount Int      @default(0)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])

  @@unique([postId, memberId])
}

// ─────────────────────────────────────────
// 돌봄 필요도 변경 이력
// ─────────────────────────────────────────

model CareLevelRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  memberId   String
  member     Member @relation("CareLevelMember", fields: [memberId], references: [id])

  assessedBy String
  assessor   Member @relation("CareLevelAssessor", fields: [assessedBy], references: [id])

  previousLevel Int?
  newLevel      Int
  note          String?
  transactionId String?

  @@index([memberId])
  @@index([assessedBy])
}

// ─────────────────────────────────────────
// 관리자 감사 로그
// ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  adminId   String
  action    String
  targetId  String?
  details   String
}

// ─────────────────────────────────────────
// 시스템 설정
// ─────────────────────────────────────────

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String
}

// ─────────────────────────────────────────
// 만보기 기록
// ─────────────────────────────────────────

model WalkRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])

  date      String   // YYYY-MM-DD
  steps     Int      @default(0)
  rewarded  Boolean  @default(false)
  rewardTxId String?

  // 재원 분리 기록
  tpFromFund        Decimal?  @db.Decimal(4, 2)  // 건강증진 기금에서 지급분
  tpFromCirculation Decimal?  @db.Decimal(4, 2)  // 순환 풀에서 지급분 (최종 구조: 항상 0)
  tpAwardedAt       DateTime?
  source            String    @default("manual")  // 'manual' | 'google_fit' | 'native_sensor'
  tpSource          String    @default("HEALTH_FUND")  // 재원 출처: 항상 건강증진 기금

  @@unique([memberId, date])
  @@index([memberId])
}

// ─────────────────────────────────────────
// 건강증진 기금 (만보기 재원)
// ─────────────────────────────────────────

model HealthFund {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  lastUpdatedAt    DateTime @updatedAt

  tpBalance         Decimal @default(0) @db.Decimal(10, 2)
  cashBalance       Decimal @default(0) @db.Decimal(12, 2)
  totalContributed  Decimal @default(0) @db.Decimal(10, 2)
  totalDistributed  Decimal @default(0) @db.Decimal(10, 2)

  transactions HealthFundTransaction[]
}

model HealthFundTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // CONTRIBUTION | WALK_REWARD | CIRCULATION | ADJUSTMENT
  txType     String
  tpAmount   Decimal @db.Decimal(10, 2)
  cashAmount Decimal @default(0) @db.Decimal(12, 2)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  fund   HealthFund @relation(fields: [fundId], references: [id])
  fundId String

  description     String
  contributorName String?
  balanceAfter    Decimal @db.Decimal(10, 2)

  @@index([txType])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// 공동체 순환 풀 (서비스 거래 환류)
// ─────────────────────────────────────────

model CirculationPool {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())

  tpBalance        Decimal @default(0) @db.Decimal(10, 2)
  totalCirculated  Decimal @default(0) @db.Decimal(10, 2)
  totalDistributed Decimal @default(0) @db.Decimal(10, 2)

  // 지불준비금 통합 (최종 구조)
  role             String  @default("RESERVE_FUND")   // 역할: 지불준비금
  circulationRate  Decimal @default(0.05) @db.Decimal(4, 3)  // 적립률: 5%
  cashBalance      Decimal @default(0)    @db.Decimal(12, 2) // 현금 잔액
  totalCashOut     Decimal @default(0)    @db.Decimal(12, 2) // 현금 지출 총액

  reserveTxs ReserveFundTransaction[]
}

// ─────────────────────────────────────────
// 지불준비금 입출금 내역
// ─────────────────────────────────────────

model ReserveFundTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // CIRCULATION_IN: 거래 환류 입금(5%)
  // CASH_CONTRIBUTION: 현금 출연
  // PRIVATE_MARKET_OUT: 민간대행 현금 지출
  // EMERGENCY_OUT: 긴급 서비스 지출
  // ADJUSTMENT: 관리자 조정
  txType    String

  tpAmount   Decimal @default(0) @db.Decimal(10, 2)
  cashAmount Decimal @default(0) @db.Decimal(12, 2)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  description      String
  tpBalanceAfter   Decimal @db.Decimal(10, 2)
  cashBalanceAfter Decimal @default(0) @db.Decimal(12, 2)
  externalVendor   String?  // 민간업체명

  pool   CirculationPool @relation(fields: [poolId], references: [id])
  poolId String          @default("circulation-pool-001")

  @@index([txType])
  @@index([memberId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// 지불준비율 설정
// ─────────────────────────────────────────

model ReserveRatioConfig {
  id                   String   @id @default("reserve-config-001")
  targetRatio          Decimal  @default(0.05) @db.Decimal(4, 3)  // 목표 지불준비율: 5%
  warningRatio         Decimal  @default(0.03) @db.Decimal(4, 3)  // 경고 기준: 3%
  criticalRatio        Decimal  @default(0.01) @db.Decimal(4, 3)  // 긴급 기준: 1%
  currentCirculationRate Decimal @default(0.05) @db.Decimal(4, 3) // 현재 적립률: 5%
  updatedAt            DateTime @updatedAt
}

// ─────────────────────────────────────────
// 만보기 연간 발행 한도
// ─────────────────────────────────────────

model WalkRewardConfig {
  year                Int     @id
  annualTpLimit       Decimal @default(100000) @db.Decimal(10, 2)
  distributedThisYear Decimal @default(0)      @db.Decimal(10, 2)
  tpPerGoal           Decimal @default(0.5)    @db.Decimal(4, 2)
  fundRatio           Decimal @default(1.0)    @db.Decimal(3, 2)  // 1.0 = 건강증진 기금 전액
  circulationRatio    Decimal @default(0.0)    @db.Decimal(3, 2)  // 0.0 = 순환 풀 미사용
}

// ─────────────────────────────────────────
// 사회적처방 전용 기금
// ─────────────────────────────────────────

model SocialPrescriptionFund {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  lastUpdatedAt       DateTime @updatedAt

  tpBalance           Decimal @default(0)      @db.Decimal(10, 2)
  cashBalance         Decimal @default(0)      @db.Decimal(12, 2)
  totalContributed    Decimal @default(0)      @db.Decimal(10, 2)
  totalDistributed    Decimal @default(0)      @db.Decimal(10, 2)
  annualLimit         Decimal @default(200000) @db.Decimal(10, 2)
  distributedThisYear Decimal @default(0)      @db.Decimal(10, 2)

  transactions SocialPrescriptionFundTx[]
}

model SocialPrescriptionFundTx {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // CONTRIBUTION | PRESCRIPTION_AWARD | RENEWAL | EXPIRY
  txType         String
  tpAmount       Decimal @db.Decimal(10, 2)
  cashAmount     Decimal @default(0) @db.Decimal(12, 2)

  prescriptionId String?
  memberId       String?
  member         Member? @relation(fields: [memberId], references: [id])

  description     String
  contributorName String?
  balanceAfter    Decimal @db.Decimal(10, 2)

  fund   SocialPrescriptionFund @relation(fields: [fundId], references: [id])
  fundId String

  @@index([txType])
  @@index([prescriptionId])
}

// ─────────────────────────────────────────
// 사회적처방전
// ─────────────────────────────────────────

model SocialPrescription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptionNo String @unique  // SP-2025-0001 형식

  // 대상자
  receiverId String
  receiver   Member @relation("PrescriptionReceiver", fields: [receiverId], references: [id])

  // 처방자
  prescriberId  String
  prescriber    Member @relation("Prescriber", fields: [prescriberId], references: [id])
  prescriberOrg  String  // 처방 기관명
  prescriberRole String  // 처방자 역할

  // 처방 내용
  careLevel            Int      // 1~5
  prescriptionReason   String[] // ['고독고립', '이동불편', ...]
  recommendedServices  String[] // ['TRANSPORT', 'COMPANION', ...]

  // TP 배분
  totalTpGranted Decimal @db.Decimal(10, 2)
  monthlyTpLimit Decimal @db.Decimal(6,  2)
  tpUsed         Decimal @default(0) @db.Decimal(10, 2)

  // 유효기간
  validFrom   DateTime
  validUntil  DateTime
  isRenewable Boolean  @default(true)

  // 처리 정보
  coordinatorId String?
  coordinator   Member?  @relation("PrescriptionCoordinator", fields: [coordinatorId], references: [id])
  approvedAt    DateTime?

  // PENDING | ACTIVE | EXPIRED | CANCELLED
  status     String  @default("PENDING")
  note       String?
  // SP_FUND | ADMIN
  fundSource String  @default("SP_FUND")

  history      PrescriptionHistory[]
  adminIssuances AdminTpIssuance[]

  @@index([receiverId])
  @@index([prescriberId])
  @@index([status])
  @@index([validUntil])
}

model PrescriptionHistory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  prescriptionId String
  prescription   SocialPrescription @relation(fields: [prescriptionId], references: [id])

  // APPROVED | RENEWED | ADJUSTED | CANCELLED
  action        String
  previousValue String?
  newValue      String?
  performedBy   String
  reason        String?

  @@index([prescriptionId])
}

// ─────────────────────────────────────────
// 관리자 마이너스 발행 추적
// ─────────────────────────────────────────

model AdminTpIssuance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // JOIN_GIFT | SOCIAL_PRESCRIPTION | EMERGENCY | MANUAL
  issuanceType     String
  tpAmount         Decimal @db.Decimal(10, 2)

  receiverId       String?
  receiver         Member? @relation("IssuanceReceiver", fields: [receiverId], references: [id])

  prescriptionId   String?
  prescription     SocialPrescription? @relation(fields: [prescriptionId], references: [id])

  cumulativeIssued Decimal @db.Decimal(14, 2)
  adminBalance     Decimal @db.Decimal(14, 2)  // 음수
  description      String

  @@index([issuanceType])
  @@index([createdAt])
}

model AdminIssuanceConfig {
  year               Int     @id
  annualLimit        Decimal @default(200000) @db.Decimal(10, 2)
  issuedThisYear     Decimal @default(0)      @db.Decimal(10, 2)
  warningThreshold   Decimal @default(70.0)   @db.Decimal(5, 2)
  criticalThreshold  Decimal @default(90.0)   @db.Decimal(5, 2)
}

// ─────────────────────────────────────────
// 웹 푸시 구독
// ─────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  @@index([memberId])
}

// ─────────────────────────────────────────
// 구글 시트 동기화 이력
// ─────────────────────────────────────────

model GoogleSheetSync {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  syncedBy  String
  syncer    Member   @relation("SyncedBy", fields: [syncedBy], references: [id])

  dong        String
  sheetUrl    String
  totalRows   Int     @default(0)
  newCount    Int     @default(0)    // 신규 등록 건수
  updateCount Int     @default(0)    // 수정 건수
  deleteCount Int     @default(0)    // 비활성화 건수
  errorCount  Int     @default(0)    // 오류 건수
  errorDetails Json?                 // 오류 상세 목록
  status      String  @default("SUCCESS")  // 'SUCCESS' | 'PARTIAL' | 'FAILED'

  @@index([syncedBy])
  @@index([dong])
  @@index([createdAt])
}
